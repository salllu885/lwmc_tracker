# Copy to .env (git-ignored) for local dev, or set as GitHub Actions repo
# secrets of the same names so the CI build can bake them in.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Must match the SYNTHETIC_EMAIL_DOMAIN env var configured for the
# admin-create-user Edge Function. Optional — defaults to lwmc.internal.
VITE_SYNTHETIC_EMAIL_DOMAIN=lwmc.internal
